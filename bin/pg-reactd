#!/usr/bin/env bash
set -euo pipefail

# PostgreSQL owns all durable worker state. One process owns each explicit
# refresh sequence; polling is authoritative and any notifier is only a hint.
database_url=${DATABASE_URL:?set DATABASE_URL}
coordinator_database_url=${COORDINATOR_DATABASE_URL:-$database_url}
rule_version_id=${1:?usage: pg-reactd RULE_VERSION_ID [worker-id]}
worker_id=${2:-"pg-reactd@$(hostname)"}
max_claims=${MAX_CLAIMS:-1}
retry_limit=${DEADLOCK_RETRY_LIMIT:-3}
refresh_id=$(date +%s)

if [[ $(psql "$database_url" -X -At -v ON_ERROR_STOP=1 -c 'SELECT pgreact.worker_protocol_compatible(1)') != t ]]; then
  echo 'pg-reactd: database does not support worker protocol 1' >&2
  exit 1
fi

psql "$coordinator_database_url" -X -v ON_ERROR_STOP=1 \
  -v rule_version_id="$rule_version_id" -v refresh_id="$refresh_id" <<'SQL'
SELECT pgreact.begin_refresh(:'rule_version_id'::uuid, :refresh_id::bigint);
BEGIN ISOLATION LEVEL READ COMMITTED;
SELECT pgreact.refresh_rule(:'rule_version_id'::uuid);
COMMIT;
SELECT pgreact.clear_refresh_barrier(:'rule_version_id'::uuid);
SELECT pgreact.release_refresh_lock();
SQL

claims=$(psql "$database_url" -X -At -F $'\t' -v ON_ERROR_STOP=1 \
  -v worker_id="$worker_id" -v max_claims="$max_claims" <<'SQL'
SELECT episode_id, lease_token
FROM pgreact.claim(:'worker_id', :max_claims::integer);
SQL
)
while IFS=$'\t' read -r episode_id lease_token; do
  [[ -n "$episode_id" ]] || continue
  for attempt in $(seq 1 "$retry_limit"); do
    if psql "$database_url" -X -v ON_ERROR_STOP=1 -v episode_id="$episode_id" \
      -v worker_id="$worker_id" -v lease_token="$lease_token" <<'SQL'
SELECT pgreact.execute_claimed_episode(:'episode_id'::bigint, :'worker_id', :'lease_token'::uuid);
SQL
    then
      break
    fi
    [[ "$attempt" -eq "$retry_limit" ]] && exit 1
    sleep 1
  done
done <<<"$claims"
